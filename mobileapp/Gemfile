source 'https://rubygems.org'

# The Ruby version is pinned in .ruby-version (rbenv picks it up). Run CocoaPods and
# fastlane through Bundler — `bundle exec pod install` — so every Mac uses the versions
# locked here instead of whatever `pod` is on its PATH.
ruby ">= 2.6.10"

# Exclude problematic versions of cocoapods and activesupport that causes build failures.
# 1.17 is what Podfile.lock is written with; it needs xcodeproj >= 1.28.1, so the
# template's old `xcodeproj < 1.26.0` cap is gone.
gem 'cocoapods', '~> 1.17'
gem 'activesupport', '>= 6.1.7.5', '!= 7.1.0'
gem 'concurrent-ruby', '< 1.3.4'

# Ruby 3.4.0 has removed some libraries from the standard library.
gem 'bigdecimal'
gem 'logger'
gem 'benchmark'
gem 'mutex_m'
gem 'nkf'

# App Store archive + upload + metadata (`bundle exec fastlane release` /
# `metadata`). Runs on the .ruby-version Ruby like everything else here.
# See ../docs/appstore/submit.md.
gem 'fastlane'
