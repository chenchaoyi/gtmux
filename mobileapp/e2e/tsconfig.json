{
  "compilerOptions": {
    "types": [
      "jest",
      "node"
    ],
    "module": "commonjs",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "target": "es2022",
    "moduleResolution": "node",
    "strict": true
  },
  "include": [
    "**/*.ts",
    "../src/constants/**/*.ts"
  ],
  "exclude": [
    "**/node_modules"
  ]
}
